{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "node scripts/hooks/progress-reminder.mjs",
            "statusMessage": "核对项目进度表…"
          }
        ]
      }
    ]
  }
}
